{
  "manifest_version": 2,
  "name": "GameGuide IGN Reader Mode",
  "version": "1.0.0",
  "description": "Removes IGN site chrome around walkthrough content while preserving article links and images.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@gameguide.app"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://ign.com/wikis/*",
        "*://*.ign.com/wikis/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
