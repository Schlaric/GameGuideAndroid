{
  "manifest_version": 2,
  "name": "GameGuide Reading Position",
  "version": "1.6",
  "description": "Remembers the article text position for GameGuide walkthroughs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "readerposition@gameguide.app"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["reader-position.js"],
      "run_at": "document_idle"
    }
  ]
}